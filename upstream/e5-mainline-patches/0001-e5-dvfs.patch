diff --git a/drivers/cpufreq/Kconfig b/drivers/cpufreq/Kconfig
index 78702a083..de278a5fc 100644
--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -259,6 +259,30 @@ endif
 
 source "drivers/cpufreq/Kconfig.arm"
 
+config E5_DVFS
+	tristate "E5 (Unisoc UMS9621) CPU DVFS through the firmware"
+	depends on CPU_FREQ
+	depends on ARCH_SPRD || COMPILE_TEST
+	depends on ARM64
+	help
+	  The CPU cluster frequency/voltage tables of the Rongyue E5 live in its
+	  trustos firmware, reached through Unisoc's SIP SVC protocol (SMC calls
+	  0x0600-0x060b).  This driver is a cpufreq client of that service: it
+	  asks the firmware for each cluster's (freq, volt) table and asks it to
+	  switch, leaving the clocks and the PMIC rails to the firmware.
+
+	  Say M here for the E5; the driver stays inert on boards whose firmware
+	  does not answer the DVFS revision call.
+
+config E5_DVFS_PROBE
+	bool "E5: read-only probe of the firmware CPU DVFS service"
+	depends on ARCH_SPRD || COMPILE_TEST
+	depends on ARM64
+	help
+	  Print the firmware's DVFS revision, the per-index (freq, volt) pairs
+	  and the current frequency for each cluster, without registering any
+	  cpufreq driver and without writing anything.  Diagnostics only.
+
 if PPC32 || PPC64
 source "drivers/cpufreq/Kconfig.powerpc"
 endif
