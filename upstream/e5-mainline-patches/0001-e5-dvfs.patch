diff --git a/drivers/cpufreq/e5-dvfs-probe.c b/drivers/cpufreq/e5-dvfs-probe.c
new file mode 100644
index 000000000..8ed2dd8eb
--- /dev/null
+++ b/drivers/cpufreq/e5-dvfs-probe.c
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * E5 (Unisoc UMS9621 / ums9158_1h10): probe the firmware's CPU DVFS service.
+ *
+ * Stage 1b, read-only on the CPU side and idempotent on the firmware side:
+ * the first probe showed that DVFS_REV answers (a0=0, a1=1) but PAIR_GET and
+ * FREQ_GET are refused with 0xffffffff until the firmware's own DVFS logic has
+ * been initialised.  The vendor driver's probe does, in this order:
+ *
+ *     dvfs_init(flag)          flag = the sprdboot.dvfs_set=0x.. token of the
+ *                              kernel command line (0 on this board)
+ *     step_set / margin_set / pmic_set / bin_set / version_set
+ *     dvfs_enable(cluster)  -- per cluster, at policy init
+ *     table_update(cluster, temp)
+ *
+ * This probe runs INIT then, for each cluster, TABLE_UPDATE at the current
+ * temperature (which is the call that reports the entry count) and re-reads
+ * PAIR_GET/FREQ_GET, so we learn what the firmware reports after init without
+ * registering any cpufreq driver.
+ *
+ * Nothing here changes the CPU frequency: INIT only turns the firmware's DVFS
+ * logic on, which the bootloader asked for anyway (sprdboot.dvfs_set=0x0 is
+ * what the vendor kernel reads as flag 0), and no FREQ_SET is ever issued.
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/sprintf.h>
+
+#define E5_SIP_DVFS_REV		ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0600)
+#define E5_SIP_DVFS_ENABLE	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0601)
+#define E5_SIP_DVFS_TABLE_UPD	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0602)
+#define E5_SIP_DVFS_STEP_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0603)
+#define E5_SIP_DVFS_MARGIN_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0604)
+#define E5_SIP_DVFS_FREQ_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0605)
+#define E5_SIP_DVFS_FREQ_GET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0606)
+#define E5_SIP_DVFS_PAIR_GET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0607)
+#define E5_SIP_DVFS_PMIC_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0608)
+#define E5_SIP_DVFS_BIN_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0609)
+#define E5_SIP_DVFS_VERSION_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x060a)
+#define E5_SIP_DVFS_INIT	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x060b)
+
+/* the flag the vendor driver reads out of the kernel command line */
+static u32 e5_cmdline_flag(void)
+{
+	struct device_node *chosen;
+	const char *cmdline, *hit;
+	u32 value = 0;
+
+	chosen = of_find_node_by_path("/chosen");
+	if (!chosen)
+		return 0;
+	if (of_property_read_string(chosen, "bootargs", &cmdline)) {
+		of_node_put(chosen);
+		return 0;
+	}
+	hit = strstr(cmdline, "sprdboot.dvfs_set=0x");
+	if (hit)
+		sscanf(hit, "sprdboot.dvfs_set=0x%x", &value);
+	of_node_put(chosen);
+	return value;
+}
+
+static void e5_dump_cluster(u32 cluster, const char *when)
+{
+	struct arm_smccc_res res;
+	int i;
+
+	for (i = 0; i < 14; i++) {
+		arm_smccc_smc(E5_SIP_DVFS_PAIR_GET, cluster, i, 0, 0, 0, 0, 0, &res);
+		pr_info("e5-dvfs-probe: %s clus%u pair[%d]: ret=0x%lx freq=%lu volt=%lu\n",
+			when, cluster, i, res.a0, res.a1, res.a2);
+		if (res.a0 || !res.a1)
+			break;
+	}
+	arm_smccc_smc(E5_SIP_DVFS_FREQ_GET, cluster, 0, 0, 0, 0, 0, 0, &res);
+	pr_info("e5-dvfs-probe: %s clus%u freq_get: ret=0x%lx freq=%lu\n",
+		when, cluster, res.a0, res.a1);
+}
+
+static int __init e5_dvfs_probe_init(void)
+{
+	struct arm_smccc_res res;
+	u32 flag, i;
+
+	arm_smccc_smc(E5_SIP_DVFS_REV, 0, 0, 0, 0, 0, 0, 0, &res);
+	pr_info("e5-dvfs-probe: DVFS_REV -> v%lu.%lu\n", res.a0, res.a1);
+
+	for (i = 0; i < 3; i++)
+		e5_dump_cluster(i, "before-init");
+
+	flag = e5_cmdline_flag();
+	pr_info("e5-dvfs-probe: dvfs_set flag = 0x%x\n", flag);
+
+	arm_smccc_smc(E5_SIP_DVFS_INIT, flag, 0, 0, 0, 0, 0, 0, &res);
+	pr_info("e5-dvfs-probe: DVFS_INIT(0x%x) -> ret=0x%lx a1=0x%lx\n", flag, res.a0, res.a1);
+
+	/*
+	 * TABLE_UPDATE is what reports the entry count, and the vendor driver
+	 * calls it before dvfs_enable() (its policy init: table_update, then
+	 * enable).  No ENABLE here: this probe leaves the clusters exactly as
+	 * the firmware had them and only reads tables.
+	 */
+	for (i = 0; i < 3; i++) {
+		/* temperature in the vendor's unit: 25 C = 25000 */
+		arm_smccc_smc(E5_SIP_DVFS_TABLE_UPD, i, 25000, 0, 0, 0, 0, 0, &res);
+		pr_info("e5-dvfs-probe: clus%u TABLE_UPDATE(25000) -> ret=0x%lx entries=%lu\n",
+			i, res.a0, res.a1);
+	}
+
+	for (i = 0; i < 3; i++)
+		e5_dump_cluster(i, "after-init");
+
+	return 0;
+}
+
+late_initcall(e5_dvfs_probe_init);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("E5: probe of the firmware CPU DVFS service (init handshake)");
diff --git a/drivers/cpufreq/e5-dvfs.c b/drivers/cpufreq/e5-dvfs.c
new file mode 100644
index 000000000..5e0561066
--- /dev/null
+++ b/drivers/cpufreq/e5-dvfs.c
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * E5 (Unisoc UMS9621 / ums9158_1h10) CPU DVFS through the device firmware.
+ *
+ * The cluster frequency/voltage tables are not in the kernel or its device
+ * tree: they live in the trustos firmware at EL3, binning- and temperature-
+ * selected there.  The vendor kernel's sprd-cpufreq-v2 driver is only a client
+ * of that service (drivers/firmware/sprd_sip_svc.c in the vendor tree), and
+ * every one of its operations is an SMC call (function numbers 0x0600-0x060b).
+ * The firmware moves the clocks and the PMIC rails together, so this driver
+ * must not touch either -- it says "cluster N, index I" and the firmware does
+ * the rest.
+ *
+ * This is that client, for the mainline kernel:
+ *   - ask the firmware for the service revision; if it does not answer, stay
+ *     out of the way (everything then works exactly as before);
+ *   - read each index's (freq, volt) pair with PAIR_GET -- nothing is
+ *     hardcoded, the firmware owns the binning/temperature selection;
+ *   - FREQ_SET for a target index, FREQ_GET for the current rate;
+ *   - (cooling devices come next, once the tables are verified on the device.)
+ *
+ * Cluster layout comes from the device tree: each cpu's
+ * sprd,freq-domain = <&cpufreq_clusN I>, I being the firmware's cluster number
+ * (0 for the six A55 cores, 1 for core 6, 2 for core 7 on this board).
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/cpu.h>
+#include <linux/cpufreq.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/thermal.h>
+
+/* Unisoc SIP SVC DVFS service (vendor include/linux/sprd_sip_svc.h) */
+#define E5_SIP_DVFS_REV		ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0600)
+#define E5_SIP_DVFS_FREQ_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0605)
+#define E5_SIP_DVFS_FREQ_GET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0606)
+#define E5_SIP_DVFS_PAIR_GET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0607)
+
+#define E5_MAX_CLUSTERS		4
+#define E5_MAX_OPP		24
+#define E5_TRANSITION_LATENCY_NS	(500 * 1000)	/* vendor: 500 us */
+
+struct e5_cluster {
+	u32		id;			/* the firmware's cluster number */
+	u32		num;			/* entries read from the firmware */
+	u64		freq_hz[E5_MAX_OPP];	/* as reported (ascending) */
+	u64		volt_uv[E5_MAX_OPP];
+};
+
+static struct e5_cluster e5_clusters[E5_MAX_CLUSTERS];
+static int e5_cluster_count;
+
+static int e5_rev(u32 *major, u32 *minor)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(E5_SIP_DVFS_REV, 0, 0, 0, 0, 0, 0, 0, &res);
+	*major = res.a0;
+	*minor = res.a1;
+	return 0;
+}
+
+static int e5_pair_get(u32 cluster, u32 index, u64 *freq_hz, u64 *volt_uv)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(E5_SIP_DVFS_PAIR_GET, cluster, index, 0, 0, 0, 0, 0, &res);
+	if (res.a0)
+		return -EINVAL;
+	if (freq_hz)
+		*freq_hz = res.a1;
+	if (volt_uv)
+		*volt_uv = res.a2;
+	return 0;
+}
+
+static int e5_freq_set(u32 cluster, u32 index)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(E5_SIP_DVFS_FREQ_SET, cluster, index, 0, 0, 0, 0, 0, &res);
+	return res.a0 ? -EINVAL : 0;
+}
+
+static int e5_freq_get(u32 cluster, u64 *freq_hz)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(E5_SIP_DVFS_FREQ_GET, cluster, 0, 0, 0, 0, 0, 0, &res);
+	if (res.a0)
+		return -EINVAL;
+	*freq_hz = res.a1;
+	return 0;
+}
+
+/* the cluster a cpu's policy belongs to, from the device tree */
+static struct e5_cluster *e5_cluster_for(struct cpufreq_policy *policy)
+{
+	struct device *cpu_dev = get_cpu_device(policy->cpu);
+	struct of_phandle_args args;
+	int ret, i;
+
+	if (!cpu_dev || !cpu_dev->of_node)
+		return NULL;
+	ret = of_parse_phandle_with_args(cpu_dev->of_node, "sprd,freq-domain",
+					 "#freq-domain-cells", 0, &args);
+	if (ret)
+		return NULL;
+	for (i = 0; i < e5_cluster_count; i++) {
+		if (e5_clusters[i].id == (u32)args.args[0]) {
+			of_node_put(args.np);
+			return &e5_clusters[i];
+		}
+	}
+	of_node_put(args.np);
+	return NULL;
+}
+
+static unsigned int e5_get(unsigned int cpu)
+{
+	struct cpufreq_policy *policy = cpufreq_cpu_get_raw(cpu);
+	struct e5_cluster *cluster;
+	u64 freq_hz = 0;
+
+	if (!policy)
+		return 0;
+	cluster = policy->driver_data;
+	if (!cluster || e5_freq_get(cluster->id, &freq_hz))
+		return 0;
+	return (unsigned int)div_u64(freq_hz, 1000);
+}
+
+static int e5_set_target(struct cpufreq_policy *policy, unsigned int index)
+{
+	struct e5_cluster *cluster = policy->driver_data;
+
+	if (!cluster)
+		return -ENODEV;
+	/* the table entry remembers the firmware's own index */
+	return e5_freq_set(cluster->id, policy->freq_table[index].driver_data);
+}
+
+static int e5_init(struct cpufreq_policy *policy)
+{
+	struct e5_cluster *cluster = e5_cluster_for(policy);
+	struct cpufreq_frequency_table *table;
+	int i;
+
+	if (!cluster || !cluster->num)
+		return -ENODEV;
+
+	table = kcalloc(cluster->num + 1, sizeof(*table), GFP_KERNEL);
+	if (!table)
+		return -ENOMEM;
+	for (i = 0; i < cluster->num; i++) {
+		table[i].frequency = (unsigned int)div_u64(cluster->freq_hz[i], 1000);
+		table[i].driver_data = i;	/* the firmware's index */
+	}
+	table[cluster->num].frequency = CPUFREQ_TABLE_END;
+
+	policy->freq_table = table;
+	policy->driver_data = cluster;
+	policy->dvfs_possible_from_any_cpu = true;
+	/* the core calls cpufreq_table_validate_and_sort() after this returns */
+	policy->cpuinfo.transition_latency = E5_TRANSITION_LATENCY_NS;
+	policy->fast_switch_possible = false;
+
+	return 0;
+}
+
+static void e5_exit(struct cpufreq_policy *policy)
+{
+	kfree(policy->freq_table);
+	policy->freq_table = NULL;
+	policy->driver_data = NULL;
+}
+
+static struct cpufreq_driver e5_cpufreq_driver = {
+	.name			= "e5-dvfs",
+	/*
+	 * No CPUFREQ_NEED_INITIAL_FREQ_CHECK: it BUG_ON()s when the frequency the
+	 * firmware reports is not in the table, and on a first bring-up that is a
+	 * panic to avoid, not a bug to catch.  The driver's ->get is the truth.
+	 */
+	.flags			= CPUFREQ_HAVE_GOVERNOR_PER_POLICY,
+	.verify			= cpufreq_generic_frequency_table_verify,
+	.init			= e5_init,
+	.exit			= e5_exit,
+	.get			= e5_get,
+	.target_index		= e5_set_target,
+	.suspend		= cpufreq_generic_suspend,
+};
+
+/*
+ * Read each cluster's table.  The vendor driver learns the entry count from
+ * TABLE_UPDATE; PAIR_GET itself has no "count" query, so walk the indices
+ * until the firmware refuses one.  Index 0 is the lowest frequency, and the
+ * table only changes with temperature, which is why reading it once at probe
+ * (the temperature the device is at) is what the firmware itself expects of a
+ * boot-time client.
+ */
+static int __init e5_read_cluster(struct e5_cluster *cluster)
+{
+	u32 i;
+
+	for (i = 0; i < E5_MAX_OPP; i++) {
+		u64 freq_hz, volt_uv;
+		int ret = e5_pair_get(cluster->id, i, &freq_hz, &volt_uv);
+
+		if (ret || !freq_hz)
+			break;
+		cluster->freq_hz[i] = freq_hz;
+		cluster->volt_uv[i] = volt_uv;
+	}
+	cluster->num = i;
+	if (i < 2) {
+		pr_info("e5-dvfs: cluster %u: firmware reports %u entr%s\n",
+			cluster->id, i, i == 1 ? "y" : "ies");
+		return i ? 0 : -ENODEV;
+	}
+	pr_info("e5-dvfs: cluster %u: %u OPPs, %llu..%llu MHz, %llu..%llu mV\n",
+		cluster->id, cluster->num,
+		cluster->freq_hz[0] / 1000000,
+		cluster->freq_hz[cluster->num - 1] / 1000000,
+		cluster->volt_uv[0] / 1000,
+		cluster->volt_uv[cluster->num - 1] / 1000);
+	return 0;
+}
+
+static int __init e5_probe_clusters(void)
+{
+	struct device_node *dvfs, *clus;
+	u32 major, minor;
+	u32 index = 0;
+
+	/* does the firmware answer at all? */
+	if (e5_rev(&major, &minor) || major == 0 || major == 0xffffffff) {
+		pr_info("e5-dvfs: firmware has no DVFS service (rev %u.%u)\n",
+			major, minor);
+		return -ENODEV;
+	}
+	pr_info("e5-dvfs: firmware DVFS service v%u.%u\n", major, minor);
+
+	dvfs = of_find_node_by_name(NULL, "apcpu-dvfs");
+	if (!dvfs) {
+		pr_info("e5-dvfs: no apcpu-dvfs node in the device tree\n");
+		return -ENODEV;
+	}
+
+	for_each_child_of_node(dvfs, clus) {
+		struct e5_cluster *cluster;
+
+		if (!of_node_name_prefix(clus, "cpufreq-clus"))
+			continue;
+		if (e5_cluster_count >= E5_MAX_CLUSTERS)
+			break;
+
+		cluster = &e5_clusters[e5_cluster_count];
+		/*
+		 * The firmware's cluster number is the phandle argument in
+		 * "sprd,freq-domain = <&cpufreq_clusN I>"; the node order
+		 * matches it on this board (clus0/1/2 -> 0/1/2).
+		 */
+		cluster->id = index++;
+		if (!e5_read_cluster(cluster))
+			e5_cluster_count++;
+	}
+	of_node_put(dvfs);
+
+	if (e5_cluster_count == 0) {
+		pr_info("e5-dvfs: no cluster answered\n");
+		return -ENODEV;
+	}
+	return 0;
+}
+
+static int __init e5_dvfs_init(void)
+{
+	int ret;
+
+	if (e5_probe_clusters())
+		return 0;	/* no DVFS here: leave the system as it was */
+
+	ret = cpufreq_register_driver(&e5_cpufreq_driver);
+	if (ret) {
+		pr_err("e5-dvfs: cpufreq_register_driver failed: %d\n", ret);
+		return ret;
+	}
+	pr_info("e5-dvfs: registered, %d cluster(s)\n", e5_cluster_count);
+	return 0;
+}
+
+device_initcall(e5_dvfs_init);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("E5 (UMS9621) CPU DVFS through the firmware's SIP SVC service");
