diff --git a/drivers/cpufreq/e5-dvfs-probe.c b/drivers/cpufreq/e5-dvfs-probe.c
new file mode 100644
index 000000000..b599b28e6
--- /dev/null
+++ b/drivers/cpufreq/e5-dvfs-probe.c
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * E5 (Unisoc UMS9621 / ums9158_1h10): probe the firmware's CPU DVFS service.
+ *
+ * Stage 3 -- the vendor driver's exact probe order.
+ *
+ * Stages 1b/2 showed DVFS_INIT succeeding but every table call still refused.
+ * The reason is the order: the vendor's probe runs sprd_cluster_info_init()
+ * FIRST, which per cluster calls sprd_cluster_props_init() -- margin_set,
+ * pmic_set, bin_set, version_set -- and only THEN pclusters->dvfs_init(flag).
+ * The firmware keeps no tables for a cluster whose binning it has not been
+ * told (all bin_set values come out of the efuse).
+ *
+ * This stage follows that order exactly:
+ *
+ *   per cluster: step_set(if present), margin_set(DT), pmic_set(2),
+ *                bin_set(nvmem cpu_bin_*), version_set(hwfeature/auto)
+ *   then:        dvfs_init(cmdline flag)
+ *   then:        table_update(cluster, 25 C) -> entry count
+ *   then:        pair_get / freq_get   (reads only)
+ *
+ * No FREQ_SET and no ENABLE: only reads and the firmware's own init.
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/sprintf.h>
+
+#define E5_SIP_DVFS_REV		ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0600)
+#define E5_SIP_DVFS_ENABLE	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0601)
+#define E5_SIP_DVFS_TABLE_UPD	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0602)
+#define E5_SIP_DVFS_STEP_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0603)
+#define E5_SIP_DVFS_MARGIN_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0604)
+#define E5_SIP_DVFS_FREQ_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0605)
+#define E5_SIP_DVFS_FREQ_GET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0606)
+#define E5_SIP_DVFS_PAIR_GET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0607)
+#define E5_SIP_DVFS_PMIC_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0608)
+#define E5_SIP_DVFS_BIN_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0609)
+#define E5_SIP_DVFS_VERSION_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x060a)
+#define E5_SIP_DVFS_INIT	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x060b)
+#define E5_SIP_DVFS_DEBUG_INIT	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x060c)
+
+static void smc1(unsigned long fn, u32 a1, u32 a2, struct arm_smccc_res *res)
+{
+	arm_smccc_smc(fn, a1, a2, 0, 0, 0, 0, 0, res);
+}
+
+static u32 e5_cmdline_flag(void)
+{
+	struct device_node *chosen = of_find_node_by_path("/chosen");
+	const char *cmdline, *hit;
+	u32 value = 0;
+
+	if (!chosen)
+		return 0;
+	if (!of_property_read_string(chosen, "bootargs", &cmdline)) {
+		hit = strstr(cmdline, "sprdboot.dvfs_set=0x");
+		if (hit)
+			sscanf(hit, "sprdboot.dvfs_set=0x%x", &value);
+	}
+	of_node_put(chosen);
+	return value;
+}
+
+/* the vendor device tree writes its u32 properties big-endian */
+static int e5_read_u32_be(struct device_node *np, const char *name, u32 *out)
+{
+	const __be32 *p = of_get_property(np, name, NULL);
+
+	if (!p)
+		return -EINVAL;
+	*out = be32_to_cpup(p);
+	return 0;
+}
+
+static u32 e5_read_bin(struct device_node *cluster_np, int *ok)
+{
+	struct nvmem_cell *cell;
+	void *buf;
+	size_t len;
+	u32 value = 0;
+
+	*ok = 0;
+	cell = of_nvmem_cell_get(cluster_np, NULL);
+	if (IS_ERR(cell)) {
+		pr_info("e5-dvfs-probe: nvmem cell: %ld\n", PTR_ERR(cell));
+		return 0;
+	}
+	buf = nvmem_cell_read(cell, &len);
+	nvmem_cell_put(cell);
+	if (IS_ERR(buf)) {
+		pr_info("e5-dvfs-probe: nvmem read: %ld\n", PTR_ERR(buf));
+		return 0;
+	}
+	memcpy(&value, buf, min_t(size_t, len, sizeof(value)));
+	kfree(buf);
+	*ok = 1;
+	return value;
+}
+
+/* per cluster, in the order the vendor's props_init uses */
+static void e5_cluster_props(struct device_node *clus, u32 id)
+{
+	struct arm_smccc_res res;
+	const char *cellname;
+	u32 margin = 0, step = 0, pmic = 2, bin = 0, version = 0;
+	int have;
+
+	if (!e5_read_u32_be(clus, "sprd,voltage-step", &step)) {
+		smc1(E5_SIP_DVFS_STEP_SET, id, step, &res);
+		pr_info("e5-dvfs-probe: clus%u STEP_SET(%u) -> 0x%lx\n", id, step, res.a0);
+	}
+	if (!e5_read_u32_be(clus, "sprd,voltage-margin", &margin)) {
+		smc1(E5_SIP_DVFS_MARGIN_SET, id, margin, &res);
+		pr_info("e5-dvfs-probe: clus%u MARGIN_SET(%u) -> 0x%lx\n", id, margin, res.a0);
+	}
+	/* the board PMIC type: pmic@2's pmic-type-num, the vendor's default */
+	smc1(E5_SIP_DVFS_PMIC_SET, id, pmic, &res);
+	pr_info("e5-dvfs-probe: clus%u PMIC_SET(%u) -> 0x%lx\n", id, pmic, res.a0);
+
+	if (!of_property_read_string(clus, "nvmem-cell-names", &cellname)) {
+		bin = e5_read_bin(clus, &have);
+		if (have) {
+			pr_info("e5-dvfs-probe: clus%u bin(%s) = %u (0x%x)\n", id, cellname, bin, bin);
+			smc1(E5_SIP_DVFS_BIN_SET, id, bin, &res);
+			pr_info("e5-dvfs-probe: clus%u BIN_SET(%u) -> 0x%lx\n", id, bin, res.a0);
+		}
+	}
+	/* the vendor calls this at the end of cluster 0's props init */
+	if (id == 0) {
+		smc1(E5_SIP_DVFS_DEBUG_INIT, 0, 0, &res);
+		pr_info("e5-dvfs-probe: DVFS_DEBUG_INIT -> 0x%lx\n", res.a0);
+	}
+
+	if (of_property_present(clus, "sprd,multi-version")) {
+		struct device_node *hwf = of_find_node_by_path("/hwfeature/auto");
+		const void *ef = hwf ? of_get_property(hwf, "efuse", NULL) : NULL;
+
+		if (ef)
+			memcpy(&version, ef, 4);
+		smc1(E5_SIP_DVFS_VERSION_SET, id, version, &res);
+		pr_info("e5-dvfs-probe: clus%u VERSION_SET(0x%x) -> 0x%lx\n", id, version, res.a0);
+		if (hwf)
+			of_node_put(hwf);
+	}
+}
+
+static void e5_dump_cluster(u32 cluster)
+{
+	struct arm_smccc_res res;
+	int i;
+
+	for (i = 0; i < 12; i++) {
+		smc1(E5_SIP_DVFS_PAIR_GET, cluster, i, &res);
+		pr_info("e5-dvfs-probe: clus%u pair[%d]: ret=0x%lx freq=%lu volt=%lu\n",
+			cluster, i, res.a0, res.a1, res.a2);
+		if (res.a0 || !res.a1)
+			break;
+	}
+	smc1(E5_SIP_DVFS_FREQ_GET, cluster, 0, &res);
+	pr_info("e5-dvfs-probe: clus%u freq_get: ret=0x%lx freq=%lu\n", cluster, res.a0, res.a1);
+}
+
+static int __init e5_dvfs_probe_init(void)
+{
+	struct arm_smccc_res res;
+	struct device_node *dvfs, *clus;
+	u32 flag, id = 0;
+
+	smc1(E5_SIP_DVFS_REV, 0, 0, &res);
+	pr_info("e5-dvfs-probe: DVFS_REV -> v%lu.%lu\n", res.a0, res.a1);
+
+	dvfs = of_find_node_by_name(NULL, "apcpu-dvfs");
+	if (!dvfs) {
+		pr_info("e5-dvfs-probe: no apcpu-dvfs node\n");
+		return 0;
+	}
+
+	/* 1. the vendor's cluster_info_init: props per cluster, no dvfs_init yet */
+	for_each_child_of_node(dvfs, clus) {
+		if (!of_node_name_prefix(clus, "cpufreq-clus"))
+			continue;
+		pr_info("e5-dvfs-probe: --- props of cluster %u ---\n", id);
+		e5_cluster_props(clus, id);
+		id++;
+	}
+
+	/* 2. then dvfs_init, as the vendor does after cluster_info_init */
+	flag = e5_cmdline_flag();
+	smc1(E5_SIP_DVFS_INIT, flag, 0, &res);
+	pr_info("e5-dvfs-probe: DVFS_INIT(0x%x) -> 0x%lx\n", flag, res.a0);
+
+	/*
+	 * 3. The vendor's policy init runs, in this order: table_update with
+	 * cluster->temp_currt_node, freq_get, then dvfs_enable.
+	 *
+	 * temp_currt_node comes from sprd_temp_list_find(head, 10): the list
+	 * holds -274, the DT's sprd,temp-threshold values (0 and 65 here) and
+	 * 274, and find() returns the node whose range holds the temperature --
+	 * for 10 C that is the node for **0**, so the argument is the node's
+	 * value, not a raw temperature.  Pass 0 first, 65 as the hot node, so
+	 * the log shows which one the firmware accepts.
+	 */
+	for (id = 0; id < 3; id++) {
+		smc1(E5_SIP_DVFS_TABLE_UPD, id, 0, &res);
+		pr_info("e5-dvfs-probe: clus%u TABLE_UPDATE(node 0) -> 0x%lx entries=%lu\n",
+			id, res.a0, res.a1);
+		smc1(E5_SIP_DVFS_TABLE_UPD, id, 65, &res);
+		pr_info("e5-dvfs-probe: clus%u TABLE_UPDATE(node 65) -> 0x%lx entries=%lu\n",
+			id, res.a0, res.a1);
+		smc1(E5_SIP_DVFS_FREQ_GET, id, 0, &res);
+		pr_info("e5-dvfs-probe: clus%u FREQ_GET -> 0x%lx freq=%lu\n", id, res.a0, res.a1);
+		smc1(E5_SIP_DVFS_ENABLE, id, 0, &res);
+		pr_info("e5-dvfs-probe: clus%u ENABLE -> 0x%lx\n", id, res.a0);
+		e5_dump_cluster(id);
+	}
+	of_node_put(dvfs);
+
+	return 0;
+}
+
+late_initcall(e5_dvfs_probe_init);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("E5: probe of the firmware CPU DVFS service (vendor order)");
diff --git a/drivers/cpufreq/e5-dvfs.c b/drivers/cpufreq/e5-dvfs.c
new file mode 100644
index 000000000..6876e2c1c
--- /dev/null
+++ b/drivers/cpufreq/e5-dvfs.c
@@ -0,0 +1,450 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * E5 (Unisoc UMS9621 / ums9158_1h10) CPU DVFS through the device firmware.
+ *
+ * The cluster frequency/voltage tables are not in the kernel or its device
+ * tree: they live in the trustos firmware at EL3, binning- and temperature-
+ * selected there.  The vendor kernel's sprd-cpufreq-v2 driver is only a client
+ * of that service (drivers/firmware/sprd_sip_svc.c in the vendor tree), and
+ * every one of its operations is an SMC call.  The firmware moves the clocks
+ * and the PMIC rails together, so this driver must not touch either -- it says
+ * "cluster N, index I" and the firmware does the rest.
+ *
+ * The handshake below is the vendor's, in its order, and each step was
+ * verified against the firmware on the device (the probe in e5-dvfs-probe.c
+ * printed the return of every call):
+ *
+ *   per cluster: step_set (if the DT has one), margin_set (DT, 20),
+ *                pmic_set (pmic@2's pmic-type-num, 2), bin_set (the efuse
+ *                bin), version_set (hwfeature/auto efuse) -- and for
+ *                cluster 0, dvfs_debug_init
+ *   then:        dvfs_init(flag), the flag from the kernel command line's
+ *                sprdboot.dvfs_set=0x.. token
+ *   per cluster: table_update(<threshold-list node>), freq_get, then
+ *                dvfs_enable; only then do pair_get and freq_get answer.
+ *
+ * Order matters: with the props after dvfs_init, or with a temperature that is
+ * not a node of the cluster's sprd,temp-threshold list, the firmware refuses
+ * every table call with 0xffffffff even though dvfs_init itself returns 0.
+ *
+ * Cluster layout comes from the device tree: each cpu's
+ * sprd,freq-domain = <&cpufreq_clusN I>, I being the firmware's cluster number
+ * (0 for the six A55 cores, 1 for core 6, 2 for core 7 on this board).
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/cpu.h>
+#include <linux/cpufreq.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/cpu_cooling.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/sprintf.h>
+
+/* Unisoc SIP SVC DVFS service (vendor include/linux/sprd_sip_svc.h) */
+#define E5_SIP_DVFS_REV		ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0600)
+#define E5_SIP_DVFS_ENABLE	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0601)
+#define E5_SIP_DVFS_TABLE_UPD	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0602)
+#define E5_SIP_DVFS_STEP_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0603)
+#define E5_SIP_DVFS_MARGIN_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0604)
+#define E5_SIP_DVFS_FREQ_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0605)
+#define E5_SIP_DVFS_FREQ_GET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0606)
+#define E5_SIP_DVFS_PAIR_GET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0607)
+#define E5_SIP_DVFS_PMIC_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0608)
+#define E5_SIP_DVFS_BIN_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x0609)
+#define E5_SIP_DVFS_VERSION_SET	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x060a)
+#define E5_SIP_DVFS_INIT	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x060b)
+#define E5_SIP_DVFS_DEBUG_INIT	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32, ARM_SMCCC_OWNER_SIP, 0x060c)
+
+#define E5_MAX_CLUSTERS		4
+#define E5_MAX_OPP		24
+#define E5_TRANSITION_LATENCY_NS	(500 * 1000)	/* vendor: 500 us */
+#define E5_DEFAULT_TEMP		10		/* vendor: DVFS_TEMP_DEFAULT, C */
+
+struct e5_cluster {
+	u32		id;			/* the firmware's cluster number */
+	bool		ready;
+	u32		num;			/* entries the firmware reported */
+	u32		temp_node;		/* the threshold node for 10 C */
+	u64		freq_hz[E5_MAX_OPP];	/* ascending, as reported */
+	u64		volt_uv[E5_MAX_OPP];
+	struct thermal_cooling_device *cdev;
+};
+
+static struct e5_cluster e5_clusters[E5_MAX_CLUSTERS];
+static int e5_cluster_count;
+
+static void smc1(unsigned long fn, u32 a1, u32 a2, struct arm_smccc_res *res)
+{
+	arm_smccc_smc(fn, a1, a2, 0, 0, 0, 0, 0, res);
+}
+
+/* the vendor device tree writes its u32 properties big-endian */
+static int e5_read_u32_be(struct device_node *np, const char *name, u32 *out)
+{
+	const __be32 *p = of_get_property(np, name, NULL);
+
+	if (!p)
+		return -EINVAL;
+	*out = be32_to_cpup(p);
+	return 0;
+}
+
+static u32 e5_cmdline_flag(void)
+{
+	struct device_node *chosen = of_find_node_by_path("/chosen");
+	const char *cmdline, *hit;
+	u32 value = 0;
+
+	if (!chosen)
+		return 0;
+	if (!of_property_read_string(chosen, "bootargs", &cmdline)) {
+		hit = strstr(cmdline, "sprdboot.dvfs_set=0x");
+		if (hit)
+			sscanf(hit, "sprdboot.dvfs_set=0x%x", &value);
+	}
+	of_node_put(chosen);
+	return value;
+}
+
+static u32 e5_read_bin(struct device_node *cluster_np, int *ok)
+{
+	struct nvmem_cell *cell;
+	void *buf;
+	size_t len;
+	u32 value = 0;
+
+	*ok = 0;
+	cell = of_nvmem_cell_get(cluster_np, NULL);
+	if (IS_ERR(cell))
+		return 0;
+	buf = nvmem_cell_read(cell, &len);
+	nvmem_cell_put(cell);
+	if (IS_ERR(buf))
+		return 0;
+	memcpy(&value, buf, min_t(size_t, len, sizeof(value)));
+	kfree(buf);
+	*ok = 1;
+	return value;
+}
+
+/*
+ * Which node of the cluster's sprd,temp-threshold list holds E5_DEFAULT_TEMP.
+ * The firmware wants that node's value, not the temperature itself.
+ */
+static u32 e5_temp_node(struct device_node *clus)
+{
+	u32 values[8], num = 0, i;
+	int n;
+
+	n = of_property_count_u32_elems(clus, "sprd,temp-threshold");
+	if (n <= 0)
+		return E5_DEFAULT_TEMP;
+	if (n > ARRAY_SIZE(values))
+		n = ARRAY_SIZE(values);
+	for (i = 0; i < n; i++) {
+		if (of_property_read_u32_index(clus, "sprd,temp-threshold", i, &values[i]))
+			return E5_DEFAULT_TEMP;
+	}
+	/* the vendor's list: -274, the DT values, 274; find() picks the range */
+	for (i = 0; i < n; i++)
+		if (E5_DEFAULT_TEMP >= (s32)values[i])
+			num = values[i];
+	return num;
+}
+
+/* per cluster, in the vendor's sprd_cluster_props_init() order */
+static void e5_cluster_props(struct device_node *clus, u32 id)
+{
+	struct arm_smccc_res res;
+	const char *cellname;
+	u32 margin = 0, step = 0, pmic = 2, bin = 0, version = 0;
+	int have;
+
+	if (!e5_read_u32_be(clus, "sprd,voltage-step", &step))
+		smc1(E5_SIP_DVFS_STEP_SET, id, step, &res);
+	if (!e5_read_u32_be(clus, "sprd,voltage-margin", &margin))
+		smc1(E5_SIP_DVFS_MARGIN_SET, id, margin, &res);
+	smc1(E5_SIP_DVFS_PMIC_SET, id, pmic, &res);
+
+	if (!of_property_read_string(clus, "nvmem-cell-names", &cellname)) {
+		bin = e5_read_bin(clus, &have);
+		if (have)
+			smc1(E5_SIP_DVFS_BIN_SET, id, bin, &res);
+	}
+	if (of_property_present(clus, "sprd,multi-version")) {
+		struct device_node *hwf = of_find_node_by_path("/hwfeature/auto");
+		const void *ef = hwf ? of_get_property(hwf, "efuse", NULL) : NULL;
+
+		if (ef)
+			memcpy(&version, ef, 4);
+		smc1(E5_SIP_DVFS_VERSION_SET, id, version, &res);
+		if (hwf)
+			of_node_put(hwf);
+	}
+	/* the vendor finishes cluster 0's props with the debug interface */
+	if (id == 0)
+		smc1(E5_SIP_DVFS_DEBUG_INIT, 0, 0, &res);
+}
+
+static int e5_read_cluster(struct e5_cluster *cluster)
+{
+	struct arm_smccc_res res;
+	u32 i;
+
+	smc1(E5_SIP_DVFS_TABLE_UPD, cluster->id, cluster->temp_node, &res);
+	if (res.a0 || !res.a1) {
+		pr_info("e5-dvfs: cluster %u: no table (table_update 0x%lx)\n",
+			cluster->id, res.a0);
+		return -ENODEV;
+	}
+	if (res.a1 > E5_MAX_OPP)
+		return -EINVAL;
+	cluster->num = res.a1;
+
+	smc1(E5_SIP_DVFS_FREQ_GET, cluster->id, 0, &res);
+	smc1(E5_SIP_DVFS_ENABLE, cluster->id, 0, &res);
+	if (res.a0) {
+		pr_info("e5-dvfs: cluster %u: enable refused (0x%lx)\n", cluster->id, res.a0);
+		return -ENODEV;
+	}
+
+	for (i = 0; i < cluster->num; i++) {
+		smc1(E5_SIP_DVFS_PAIR_GET, cluster->id, i, &res);
+		if (res.a0 || !res.a1)
+			return -EINVAL;
+		cluster->freq_hz[i] = res.a1;
+		cluster->volt_uv[i] = res.a2;
+	}
+	pr_info("e5-dvfs: cluster %u: %u OPPs, %llu..%llu MHz\n", cluster->id,
+		cluster->num, cluster->freq_hz[0] / 1000000,
+		cluster->freq_hz[cluster->num - 1] / 1000000);
+	return 0;
+}
+
+/* the cluster a cpu's policy belongs to, from the device tree */
+static struct e5_cluster *e5_cluster_for(struct cpufreq_policy *policy)
+{
+	struct device *cpu_dev = get_cpu_device(policy->cpu);
+	struct of_phandle_args args;
+	int ret, i;
+
+	if (!cpu_dev || !cpu_dev->of_node)
+		return NULL;
+	ret = of_parse_phandle_with_args(cpu_dev->of_node, "sprd,freq-domain",
+					 "#freq-domain-cells", 0, &args);
+	if (ret)
+		return NULL;
+	for (i = 0; i < e5_cluster_count; i++) {
+		if (e5_clusters[i].id == (u32)args.args[0] && e5_clusters[i].ready) {
+			of_node_put(args.np);
+			return &e5_clusters[i];
+		}
+	}
+	of_node_put(args.np);
+	return NULL;
+}
+
+static unsigned int e5_get(unsigned int cpu)
+{
+	struct cpufreq_policy *policy = cpufreq_cpu_get_raw(cpu);
+	struct e5_cluster *cluster;
+	struct arm_smccc_res res;
+
+	if (!policy)
+		return 0;
+	cluster = policy->driver_data;
+	if (!cluster)
+		return 0;
+	smc1(E5_SIP_DVFS_FREQ_GET, cluster->id, 0, &res);
+	if (res.a0)
+		return 0;
+	return (unsigned int)div_u64(res.a1, 1000);
+}
+
+static int e5_set_target(struct cpufreq_policy *policy, unsigned int index)
+{
+	struct e5_cluster *cluster = policy->driver_data;
+	struct arm_smccc_res res;
+
+	if (!cluster)
+		return -ENODEV;
+	/* the table keeps the firmware's own index in driver_data */
+	smc1(E5_SIP_DVFS_FREQ_SET, cluster->id, policy->freq_table[index].driver_data, &res);
+	return res.a0 ? -EINVAL : 0;
+}
+
+static int e5_init(struct cpufreq_policy *policy)
+{
+	struct e5_cluster *cluster = e5_cluster_for(policy);
+	struct cpufreq_frequency_table *table;
+	int i;
+
+	if (!cluster || !cluster->num)
+		return -ENODEV;
+
+	table = kcalloc(cluster->num + 1, sizeof(*table), GFP_KERNEL);
+	if (!table)
+		return -ENOMEM;
+	for (i = 0; i < cluster->num; i++) {
+		table[i].frequency = (unsigned int)div_u64(cluster->freq_hz[i], 1000);
+		table[i].driver_data = i;
+	}
+	table[cluster->num].frequency = CPUFREQ_TABLE_END;
+
+	policy->freq_table = table;
+	policy->driver_data = cluster;
+	policy->dvfs_possible_from_any_cpu = true;
+	/* the core validates and sorts the table after this returns */
+	policy->cpuinfo.transition_latency = E5_TRANSITION_LATENCY_NS;
+	policy->fast_switch_possible = false;
+	return 0;
+}
+
+static void e5_exit(struct cpufreq_policy *policy)
+{
+	kfree(policy->freq_table);
+	policy->freq_table = NULL;
+	policy->driver_data = NULL;
+}
+
+/*
+ * Every policy that came up also becomes a cooling device, so the thermal
+ * zones the bootloader's device tree declares can clamp the CPU when it gets
+ * hot.  Without it the E5 has 25 thermal zones and nothing to cool them with
+ * (every zone shows cooling_device state 0 and the SoC has no other lever).
+ *
+ * of_cpufreq_cooling_register() looks for #cooling-cells on the policy's CPU
+ * node, which the vendor device tree has; it still registers when no energy
+ * model is present (it just leaves out the power extensions), which is the
+ * case here -- the firmware owns the voltage, so there are no OPPs to build
+ * one from.
+ */
+static int e5_ready(struct cpufreq_policy *policy)
+{
+	struct e5_cluster *cluster = policy->driver_data;
+	struct thermal_cooling_device *cdev;
+
+	if (!cluster)
+		return 0;
+	cdev = of_cpufreq_cooling_register(policy);
+	if (IS_ERR_OR_NULL(cdev)) {
+		pr_info("e5-dvfs: cluster %u: no cooling device (%ld)\n",
+			cluster->id, PTR_ERR(cdev) ? PTR_ERR(cdev) : 0);
+		return 0;
+	}
+	cluster->cdev = cdev;
+	pr_info("e5-dvfs: cluster %u: cooling device \"%s\" (%u states)\n",
+		cluster->id, cdev->type, (unsigned int)cdev->max_state);
+	return 0;
+}
+
+static struct cpufreq_driver e5_cpufreq_driver = {
+	.name			= "e5-dvfs",
+	/*
+	 * No CPUFREQ_NEED_INITIAL_FREQ_CHECK: it BUG_ON()s when the current
+	 * frequency is not in the table, which on a first bring-up is a panic
+	 * to avoid rather than a bug to catch.  ->get is the truth.
+	 */
+	.flags			= CPUFREQ_HAVE_GOVERNOR_PER_POLICY,
+	.verify			= cpufreq_generic_frequency_table_verify,
+	.init			= e5_init,
+	.exit			= e5_exit,
+	.get			= e5_get,
+	.target_index		= e5_set_target,
+	.suspend		= cpufreq_generic_suspend,
+	.ready			= e5_ready,
+};
+
+/*
+ * The firmware's own bring-up, in the vendor's order.  cluster_info_init()
+ * (the props of every cluster) runs first, dvfs_init() after it, and only
+ * then does a cluster's table answer.
+ */
+static void __init e5_firmware_init(void)
+{
+	struct arm_smccc_res res;
+	struct device_node *dvfs, *clus;
+	u32 id = 0;
+
+	/*
+	 * DVFS_REV returns the revision IN a0/a1 ("0.1" on this firmware), not a
+	 * status: a0 == 0 is a valid major version, not a refusal.  The refusal
+	 * this protocol uses is 0xffffffff (SPRD_SIP_RET_UNK), the value every
+	 * other call returns when the firmware will not serve it.  (The probe
+	 * printed a0=0 a1=1 as "v0.1" from the start; the first version of this
+	 * check read a0 as a status and refused to register.)
+	 */
+	smc1(E5_SIP_DVFS_REV, 0, 0, &res);
+	if (res.a0 == 0xffffffff) {
+		pr_info("e5-dvfs: firmware has no DVFS service (rev %lu.%lu)\n",
+			res.a0, res.a1);
+		return;
+	}
+	pr_info("e5-dvfs: firmware DVFS service v%lu.%lu\n", res.a0, res.a1);
+
+	dvfs = of_find_node_by_name(NULL, "apcpu-dvfs");
+	if (!dvfs)
+		return;
+
+	for_each_child_of_node(dvfs, clus) {
+		struct e5_cluster *cluster;
+
+		if (!of_node_name_prefix(clus, "cpufreq-clus"))
+			continue;
+		if (e5_cluster_count >= E5_MAX_CLUSTERS)
+			break;
+		cluster = &e5_clusters[e5_cluster_count];
+		cluster->id = id;
+		cluster->temp_node = e5_temp_node(clus);
+		e5_cluster_props(clus, id);
+		id++;
+		e5_cluster_count++;
+	}
+
+	smc1(E5_SIP_DVFS_INIT, e5_cmdline_flag(), 0, &res);
+	if (res.a0)
+		pr_info("e5-dvfs: dvfs_init refused (0x%lx)\n", res.a0);
+
+	for (id = 0; id < e5_cluster_count; id++) {
+		if (!e5_read_cluster(&e5_clusters[id]))
+			e5_clusters[id].ready = true;
+	}
+	of_node_put(dvfs);
+}
+
+static int __init e5_dvfs_init(void)
+{
+	int ready = 0, i;
+
+	e5_firmware_init();
+	for (i = 0; i < e5_cluster_count; i++)
+		ready += e5_clusters[i].ready;
+
+	if (!ready)
+		return 0;	/* no DVFS here: leave the system as it was */
+
+	if (cpufreq_register_driver(&e5_cpufreq_driver)) {
+		pr_err("e5-dvfs: cpufreq_register_driver failed\n");
+		return -ENODEV;
+	}
+	pr_info("e5-dvfs: registered, %d cluster(s)\n", ready);
+	return 0;
+}
+
+static void __exit e5_dvfs_exit(void)
+{
+	int i;
+
+	for (i = 0; i < e5_cluster_count; i++) {
+		if (e5_clusters[i].cdev)
+			cpufreq_cooling_unregister(e5_clusters[i].cdev);
+	}
+	cpufreq_unregister_driver(&e5_cpufreq_driver);
+}
+
+module_exit(e5_dvfs_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("E5 (UMS9621) CPU DVFS through the firmware's SIP SVC service");
