#!/bin/sh /etc/rc.common
# The CPU's firmware DVFS (e5-dvfs.ko): the cluster frequency tables live in
# the trustos firmware and this module is their cpufreq client (kernel tree:
# drivers/cpufreq/e5-dvfs.c, applied by upstream/e5-mainline-patches/).  It is
# a module rather than built-in on purpose: registering cpufreq runs a FREQ_SET
# almost at once, and doing that during early boot stopped the device from
# booting at all.  Loading it here, once the system is up, keeps a firmware
# that dislikes the handshake from taking the boot down with it.
#
# The module logs the tables it read and says "registered, N cluster(s)"; if
# the firmware refuses, it stays inert and the CPU simply keeps the frequency
# the bootloader left it at.
START=98
USE_PROCD=1

start_service() {
	[ "$(uci -q get e5-dvfs.main.enabled)" = 0 ] && return 0
	R=$(uname -r)
	M=/lib/modules/$R/cpufreq/e5-dvfs.ko
	[ -f "$M" ] || { logger -t e5-dvfs "no $M"; return 0; }
	# (nothing else loads it: kmodloader's insmod only serves kmod packages)
	procd_open_instance
	procd_set_param command /bin/sh -c '
		R=$(uname -r); M=/lib/modules/$R/cpufreq/e5-dvfs.ko
		grep -q "^e5_dvfs " /proc/modules && exit 0
		insmod "$M" 2>&1 | logger -t e5-dvfs
		sleep 1
		if grep -q "^e5_dvfs " /proc/modules; then
			logger -t e5-dvfs "loaded; policies: $(ls /sys/devices/system/cpu/cpufreq 2>/dev/null | tr "\n" " ")"
		else
			logger -t e5-dvfs "not loaded (firmware refused?)"
		fi'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rmmod e5_dvfs 2>/dev/null
	return 0
}
